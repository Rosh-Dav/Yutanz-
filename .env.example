# YouTube Data API v3 Key (Obtain from Google Cloud Console: https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Sentiment Analysis API Endpoint
# Default for local backend (see backend/ folder):
SENTIMENT_API_URL=http://localhost:7860
# Or if you deploy your own Hugging Face Gradio Space:
# SENTIMENT_API_URL=https://your-username-sentiment-api.hf.space
